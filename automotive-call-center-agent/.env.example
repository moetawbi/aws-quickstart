# Copy to .env and fill in. Load with:  set -a; source .env; set +a

# --- Required: Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Agent (optional) ---
#CALL_CENTER_MODEL=claude-opus-5
#CALL_CENTER_EFFORT=medium          # low | medium | high | xhigh | max

# --- CRM (optional: unset = built-in mock CRM) ---
#CRM_API_BASE_URL=https://crm.example.com/api
#CRM_API_KEY=...
#CRM_TIMEOUT_SECONDS=10

# --- Knowledge & manuals (optional: defaults to ./knowledge and ./manuals) ---
#KNOWLEDGE_DIR=./knowledge
#MANUALS_DIR=./manuals

# --- Memory (optional: defaults to ./memory) ---
#MEMORY_DIR=./memory

# --- Trengo (needed for Trengo testing only) ---
#TRENGO_API_KEY=...                 # Trengo Settings -> API
#TRENGO_POLL_SECONDS=20
#TRENGO_WEBHOOK_SECRET=...          # e.g. openssl rand -hex 24
#TRENGO_WEBHOOK_PORT=8080

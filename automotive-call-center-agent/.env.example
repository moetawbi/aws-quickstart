# Copy to .env and fill in. Load with:  set -a; source .env; set +a

# --- Required: Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Agent (optional) ---
#CALL_CENTER_MODEL=claude-opus-5
#CALL_CENTER_EFFORT=medium          # low | medium | high | xhigh | max

# --- CRM (optional: unset = built-in mock CRM) ---
#CRM_API_BASE_URL=https://crm.example.com/api
#CRM_API_KEY=...
#CRM_TIMEOUT_SECONDS=10

# --- Knowledge & manuals (optional: defaults to ./knowledge and ./manuals) ---
#KNOWLEDGE_DIR=./knowledge
#MANUALS_DIR=./manuals

# --- Memory (optional: defaults to ./memory) ---
#MEMORY_DIR=./memory

# --- Admin API (manage knowledge/manuals/memory from the CRM backend) ---
#ADMIN_API_TOKEN=...                # e.g. openssl rand -hex 24; required to start admin_api.py
#ADMIN_API_BIND=127.0.0.1
#ADMIN_API_PORT=8081

# Chat API (chat_api.py) - the CRM's in-panel Agent Chat page talks to this.
#CHAT_API_TOKEN=...                 # e.g. openssl rand -hex 24; required to start chat_api.py
#CHAT_API_BIND=127.0.0.1
#CHAT_API_PORT=8082
#CHAT_SESSION_TTL_SECONDS=7200      # idle sessions are dropped after this
#CHAT_MAX_SESSIONS=200

# --- Trengo (needed for Trengo testing only) ---
# Nothing is posted to a customer and the worker/webhook refuse to start
# unless this is exactly 1. Leave it unset while the agent is internal-only.
#TRENGO_REPLIES_ENABLED=1
#TRENGO_API_KEY=...                 # Trengo Settings -> API
#TRENGO_POLL_SECONDS=20
#TRENGO_WEBHOOK_SECRET=...          # e.g. openssl rand -hex 24
#TRENGO_WEBHOOK_PORT=8080

# Catalogues (catalogue.py) - configured per agent in the CRM. The runtime
# fetches each feed itself; prices are stripped at parse time.
#CATALOGUES_DIR=                     # default ./catalogues
#CATALOGUE_MAX_FEED_BYTES=20971520   # refuse feeds larger than this
#CATALOGUE_MAX_ITEMS=20000
#CATALOGUE_FETCH_TIMEOUT=20
#CATALOGUE_RETRY_AFTER_SECONDS=300   # back-off after a failed fetch
#CATALOGUE_ALLOW_PRIVATE_HOSTS=      # NEVER set in production: allows feeds on private/loopback addresses

# Agent configs (agent_config.py) - fetched from the CRM per conversation.
#AGENT_CONFIG_TTL_SECONDS=300

